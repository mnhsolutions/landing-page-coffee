---
import "@styles/global.css";
import CartInitializer from "@components/CartInitializer";
import IconClosemenu from "src/icons/IconClosemenu.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Coffee landing</title>
  </head>

  <body class="m-0 w-full">
    <main class="grid grid-cols-1">
      <section id="hero" class="min-h-screen">
        <slot name="hero" />
      </section>

      <div id="hero-end" class="w-full h-[1px] pointer-events-none"></div>
      <section id="about" class="min-h-[80vh]">
        <slot name="about" />
      </section>

      <section id="coffees" class="min-h-[70vh]">
        <slot name="coffees" />
      </section>

      <section id="menu" class="min-h-fit md:min-h-[80vh]">
        <slot name="menu" />
      </section>

      <section id="services" class="min-h-fit md:min-h-[80vh]">
        <slot name="services" />
      </section>

      <section id="contact" class="min-h-[90vh]">
        <slot name="contact" />
      </section>

      <footer id="footer" class="min-h-[20vh]">
        <slot name="footer" />
      </footer>
    </main>

 <!-- Carrito overlay -->
<div id="cart-overlay" class="fixed inset-0 z-50 hidden bg-black/40">
  <div id="cart-sidebar"
    class="absolute right-0 top-0 h-full w-full md:w-1/3 bg-white shadow-lg p-6 flex flex-col
    transform translate-x-full transition-transform duration-300">
    <header class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-bold">Carrito</h2>
      <button id="close-cart" class="text-2xl cursor-pointer">
        <IconClosemenu />
      </button>
    </header>

    <ul id="cart-items" class="flex-1 overflow-y-auto space-y-4 ">
      <!-- Aquí se agregan los productos del carrito -->
    </ul>

    <footer class="mt-4">
      <p id="cart-total-wrapper" class="font-bold text-lg hidden">
        Total: $<span id="cart-total"></span>
      </p>
      <button id="go-checkout" class="w-full mt-2 bg-amber-500 text-white py-4 rounded-xl cursor-pointer">
        Pagar
      </button>
    </footer>
  </div>
</div>

  <!-- Toast de notifiacion del carrito  -->
  <div id="toast"
    class="fixed top-0 left-1/2 -translate-x-1/2 z-[999] mt-2 px-6 py-3 rounded-lg shadow-lg
    text-white text-sm font-medium opacity-0 -translate-y-6 transition-all duration-300 pointer-events-none">
  </div>

  <!-- Inicializamos el carrito en cliente -->
  <CartInitializer client:load />

  <script type="module" src="/src/utils/cartSidebar.js"></script>
  <script type="module" src="/src/utils/navbarColorOnScroll.js"></script>
  </body>
</html>
