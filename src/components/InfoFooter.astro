---
const {
  imageCard,
  Title,
  subTitle,
  width = "w-40",
} = Astro.props;
---

<div
  class={`${width} h-24 grid grid-cols-[40px_1fr] gap-2 items-center`}
>
  <img
    src={imageCard}
    alt={Title}
    class="w-10 h-10 object-contain justify-self-center"
  />

  <div class="info flex items-start px-2 flex-col text-sm leading-tight">
    <h1 class="text-lg font-semibold">{Title}</h1>
    <p class="text-xs text-gray-600">{subTitle}</p>
  </div>
</div>
