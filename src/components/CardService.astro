---
const { image, title, description } = Astro.props;
---

<article class="menu-card grid grid-rows-[auto_1fr] min-h-[450px] w-72 rounded-xl py-4 px-4"
  style={`box-shadow: rgba(17, 17, 26, 0.1) 0px 4px 16px, rgba(17, 17, 26, 0.05) 0px 8px 32px;box-shadow: rgba(17, 17, 26, 0.1) 0px 4px 16px, rgba(17, 17, 26, 0.05) 0px 8px 32px;`}>
  
  <div class="content flex justify-center items-center overflow-hidden">
    <img src={image} alt={title} class="w-full h-auto max-w-full object-contain" />
  </div>

  <footer class="grid grid-cols-1 gap-2 py-2">
    <div class="product-info flex flex-col justify-center gap-6">
      <h3 class="text-[1.10rem] text-center font-semibold font-heading leading-tight">
        {title}
      </h3>
      <p class="text-sm text-gray-700 text-center font-semibold opacity-70 px-4">
        {description}
      </p>
    </div>
  </footer>
</article>
