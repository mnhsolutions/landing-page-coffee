---
import services from "../data/services.json";
import CardService from "@components/CardService.astro";
---

<section>
  <div class="max-w-[1200px] mx-auto py-10">
    <section class="flex flex-col gap-10 mx-0">
      <header class="flex items-center justify-center">
        <h1 class="relative text-2xl font-bold after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px] after:h-[3px] after:w-44 after:bg-amber-500">
          Nuestros servicios
        </h1>
      </header>

      <ul class="flex overflow-x-auto gap-6 snap-x snap-mandatory px-4 pb-4
          sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:gap-8 justify-items-center
          lg:grid-cols-4">
        {
          services.services.map((service) => (
            <li class="snap-center shrink-0 w-72 sm:w-auto">
              <CardService {...service} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>
