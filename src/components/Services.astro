---
import services from "../data/services.json"
import CardService from "@components/CardService.astro"
---

<section>
  <div class="max-w-[1200px] mx-auto py-10">
    <section class="flex flex-col gap-10 mx-0">
      <header class="flex items-center">
        <h1 class="text-2xl font-bold">Nuestros Servicios</h1>
        <div class="h-[3px] w-24 bg-amber-500 translate-3"></div>
      </header>

      <ul id="menu-list" 
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mx-auto w-fit">
        {
          services.services.map((service) => (
            <CardService {...service} />
          ))
        }
      </ul>
    </section>
  </div>
</section>
