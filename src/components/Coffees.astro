---
import CoffeeCard from "@components/CoffeeCard.astro";
import coffees from "../data/coffees.json";
---

<section
  class="
    flex overflow-x-auto gap-6
    snap-x snap-mandatory
    px-4 pb-4
    sm:grid sm:grid-cols-2
    lg:grid-cols-4
    sm:overflow-visible
    sm:px-0
    sm:gap-6
    max-w-7xl mx-auto
  ">
  {coffees.coffees.map((coffee) => (
    <div class="snap-center shrink-0 w-72 sm:w-auto">
      <CoffeeCard {...coffee} />
    </div>
  ))}
</section>
