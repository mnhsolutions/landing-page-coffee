---
import CoffeeCard from "@components/CoffeeCard.astro";
import coffees from "../data/coffees.json";
---

<section>
  <div class="max-w-[1200px] mx-auto py-10">
    <section class="flex flex-col gap-10 mx-0">
      <header class="flex items-center justify-center">
        <h1 class="relative text-2xl font-bold after:absolute after:left-1/2 after:-translate-x-1/2 after:bottom-[-8px] after:h-[3px] after:w-44 after:bg-amber-500">
          Descubre nuestros cafés
        </h1>
      </header>

      <ul
       class="flex overflow-x-auto gap-2 snap-x snap-mandatory px-3 pb-4
       sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:gap-8
       justify-items-center
       lg:grid-cols-4 lg:gap-6
       xl:grid-cols-4 xl:max-w-[1200px] xl:mx-auto">
        {
          coffees.coffees.map((service) => (
            <li class="snap-center shrink-0 w-auto sm:w-auto">
              <CoffeeCard {...service} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>