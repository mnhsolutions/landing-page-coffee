---
import LinkNavBar from "@components/LinkNavBar.astro";
import CartIcon from "../icons/CartIcon.astro";
import IconMenuNavbar from "src/icons/IconMenuNavbar.astro"
import IconClosemenu from "src/icons/IconClosemenu.astro";
---

<nav class="relative flex items-center justify-between h-20 md:h-24 px-4 md:px-0">
  <!-- Logo -->
  <h4 class="text-xl md:text-2xl font-bold text-white">CoffeeLab</h4>

  <!-- Links Desktop -->
  <div class="hidden md:flex items-center gap-6">
    <LinkNavBar titleLink="Sobre nosotros" href="#about" />
    <LinkNavBar titleLink="Nuestro café" href="#coffees" />
    <LinkNavBar titleLink="Menú" href="#menu" />
    <LinkNavBar titleLink="Servicios" href="#services" />
    <LinkNavBar titleLink="Contacto" href="#contact" />
  </div>

  <!-- Mobile & Desktop Cart + Hamburger -->
  <div class="flex items-center gap-4">
    <!-- Cart siempre visible -->
    <button id="cart-icon" class="cursor-pointer">
      <CartIcon />
    </button>

    <!-- Hamburger solo en mobile -->
    <button
      id="menu-toggle"
      class="flex flex-col justify-center items-center w-6 h-6 gap-1 md:hidden">
      <IconMenuNavbar />
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-black/90 z-50 hidden flex-col items-center justify-center space-y-8 text-white text-xl"
  >
    <button id="close-menu" class="absolute top-6 right-6 text-3xl">
      <IconClosemenu />
    </button>
    <LinkNavBar titleLink="Sobre nosotros" href="#about" />
    <LinkNavBar titleLink="Nuestro café" href="#coffees" />
    <LinkNavBar titleLink="Menú" href="#menu" />
    <LinkNavBar titleLink="Servicios" href="#services" />
    <LinkNavBar titleLink="Contacto" href="#contact" />
  </div>
</nav>

<script type="module" src="/src/utils/toggleSidebar.js"></script>
