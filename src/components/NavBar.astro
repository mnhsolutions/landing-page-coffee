---
import LinkNavBar from "@components/LinkNavBar.astro";
import CartIcon from "../icons/CartIcon.astro";
import IconMenuNavbar from "src/icons/IconMenuNavbar.astro"
import IconClosemenu from "src/icons/IconClosemenu.astro";
---

<nav
  <nav id="navbar"
   class="fixed top-0 left-0 w-full z-40 flex items-center justify-between h-20 
    md:h-18 px-6 md:px-26 
  text-white bg-transparent
    transition-all duration-300">

  <!-- Logo -->
  <h4 class="text-xl md:text-2xl font-bold text-current">CoffeeLab</h4>

  <!-- Links Desktop -->
  <div class="hidden md:flex items-center gap-6">
    <LinkNavBar titleLink="Nuestro café" href="#coffees" />
    <LinkNavBar titleLink="Menú" href="#menu" />
    <LinkNavBar titleLink="Sobre nosotros" href="#about" />
    <LinkNavBar titleLink="Servicios" href="#services" />
    <LinkNavBar titleLink="Contacto" href="#contact" />
  </div>

  <!-- Mobile & Desktop Cart + Hamburger -->
  <div class="flex items-center gap-4">
    <!-- Cart siempre visible -->
    <button id="cart-icon" class="cursor-pointer">
      <CartIcon />
    </button>

    <!-- Hamburger solo en mobile -->
    <button
      id="menu-toggle"
      class="flex flex-col justify-center items-center w-6 h-6 gap-1 md:hidden">
      <IconMenuNavbar />
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div id="mobile-menu"
  class="fixed inset-0 w-screen h-screen bg-[#362415] z-50 hidden flex flex-col items-center justify-center space-y-8
    text-white text-xl gap-4">
    <button id="close-menu"
      class="absolute top-6 right-6 text-3xl">
        <IconClosemenu size={32} />
    </button>
    <h4 class="text-2xl font-bold text-current">CoffeeLab</h4>
    <LinkNavBar titleLink="Home" href="#hero"  />
    <LinkNavBar titleLink="Nuestro café" href="#coffees" />
    <LinkNavBar titleLink="Nuestro Menú" href="#menu" />
    <LinkNavBar titleLink="Sobre nosotros" href="#about"  />
    <LinkNavBar titleLink="Servicios" href="#services" />
    <LinkNavBar titleLink="Contacto" href="#contact" />
  </div>
</nav>

<script type="module" src="/src/utils/toggleSidebar.js"></script>
