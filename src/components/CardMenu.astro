---
const { image, title, price, category, description } = Astro.props;
import StarIcon from "../icons/StarIcon.astro";
import AddIcon from "src/icons/AddIcon.astro";
---

<li class="menu-card grid grid-rows-[20%_50%_30%] h-72 w-72 rounded-xl py-4 px-8"
  data-category={category}
  style={`box-shadow: rgba(17, 17, 26, 0.1) 0px 4px 16px, rgba(17, 17, 26, 0.05) 0px 8px 32px;box-shadow: rgba(17, 17, 26, 0.1) 0px 4px 16px, rgba(17, 17, 26, 0.05) 0px 8px 32px;`}>
  <header class="flex justify-between items-center">
    <div class="product-rating flex gap-2">
      <h1 class="text-sm font-bold">4.8</h1>
      <span class="text-[#F4C430]">
        <StarIcon />
      </span>
    </div>
    <button
      class="flex justify-center items-center h-8 w-8 bg-amber-500 rounded-full shrink-0
      hover:cursor-pointer hover:bg-amber-800 transition-colors duration-300 ease-in-out">
      <AddIcon />
    </button>
  </header>

  <div class="content flex justify-center items-center overflow-hidden">
    <img src={image} alt={title} class="h-full w-full object-contain" />
  </div>

  <footer class="grid grid-cols-[3fr_1fr] gap-2 py-2">
    <div class="product-info flex flex-col gap-2">
      <h3 class="text-[1.10rem] font-semibold font-heading leading-tight line-clamp-1">
        {title}
      </h3>
      <p class="text-sm text-gray-700 font-semibold opacity-70 line-clamp-2">
        {description}
      </p>
    </div>

    <div class="product-price flex justify-end">
      <span class="text-right text-lg font-bold">
        ${price}
      </span>
    </div>
  </footer>
</li>
